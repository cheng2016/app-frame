## Copy to local.properties (do not commit secrets)

sdk.dir=D\:\\Android\\Sdk

# Release / debug signing (defaults match historical demo keystore app/wecare.jks)
# STORE_FILE=wecare.jks
# STORE_PASSWORD=123456
# KEY_ALIAS=wecare
# KEY_PASSWORD=123456

# Optional WeChat OpenSDK app id (never put AppSecret here)
# WX_APP_ID=

# Demo mode default (true = offline showcase)
DEMO_MODE=true
